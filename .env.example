# ============================================
# Variables de entorno - Marroquinería Artesanal
# Copiá este archivo como .env y completá los valores
# ============================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generá-una-clave-larga-y-aleatoria-aquí

# Base de datos
# Desarrollo (SQLite local):
DATABASE_URL=sqlite:///dev.db
# Producción (Render / PostgreSQL):
# DATABASE_URL=postgresql://usuario:pass@host:5432/dbname

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_DEFAULT_SENDER=marroquineriapeluzza@gmail.com

# Mercado Pago (clave de acceso para cobros)
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Dominio público (usado para generar links en emails y webhook de MP)
PUBLIC_URL=http://localhost:5000

# Subida de imágenes
MAX_IMAGE_SIZE_MB=5
MAX_EXTRA_IMAGES=5